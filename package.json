		"autoprefixer": "^10.4.14",
		"eslint": "^8.46.0",
		"eslint-config-prettier": "^8.10.0",
		"lint-staged": "^13.2.3",
		"postcss": "^8.4.31",
		"prettier": "^2.8.8",
		"sass": "^1.65.1",
		"svelte": "^5.25.7",
		"svelte-check": "^3.7.1",
		"tailwindcss": "^3.3.3",
		"tslib": "^2.6.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.0",
		"vitest": "^1.0.0"
	},
	"type": "module",
	"dependencies": {
