{
	"name": "my-sveltekit-app",
	"description": "Use TypeScript, TailwindCSS & Sass to quick start your new SvelteKit app!!",
	"version": "1.0.0",
	"author": {
		"name": "Brian Cairns"
	},
	"license": "MIT",
	"keywords": [
		"tailwindcss",
		"svelte",
		"sveltekit",
		"svelte kit",
		"starter",
		"typescript",
		"prettier",
		"eslint",
		"sass",
		"react",
		"husky",
		"postcss",
		"sass",
		"svelte starter",
		"sveltekit starter",
		"svelte kit starter",
		"tailwindcss starter",
		"svelte tailwindcss starter",
		"sveltekit tailwindcss starter",
